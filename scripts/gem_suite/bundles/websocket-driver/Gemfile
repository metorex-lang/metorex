# The gems websocket-driver's specs load. websocket-driver itself is left out,
# since its specs load it from the checkout, and its extension is built by
# scripts/run_gem_suites.sh under the engine the specs run with.
source "https://rubygems.org"

eval_gemfile "../ruby_shipped.rb"

gem "websocket-extensions", path: "../../../../gems/websocket-extensions"
gem "rspec"

shipped "base64"
