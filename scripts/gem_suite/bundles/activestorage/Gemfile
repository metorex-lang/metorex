# The gems activestorage's tests load, at the versions the rails
# repository's lockfile names: every framework, since the dummy
# application requires rails/all, with what each loads, sqlite3 for the
# database, image_processing with mini_magick and ruby-vips for the
# variants, propshaft for the dummy application's config.assets, and
# webmock. sqlite3, ffi, nio4r and websocket-driver come
# from rubygems.org, so Metorex builds their extensions when they are
# first loaded. google-cloud-storage is for the GCS signature tests,
# which run without a configuration. The other cloud service tests
# define no tests without test/service/configurations.yml.
source "https://rubygems.org"

eval_gemfile "../ruby_shipped.rb"

