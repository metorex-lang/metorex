# The gems activesupport's tests load, at the versions the rails
# repository's own Gemfile allows. libxml-ruby, whose C extension Metorex
# does not build, is left out, so its XmlMini tests are skipped under either
# engine. The cache store tests for memcached and Redis reach servers on
# their default ports, which the suite does not start.
source "https://rubygems.org"

eval_gemfile "../ruby_shipped.rb"

gem "activesupport", path: "../../../../gems/rails/activesupport"
gem "i18n", path: "../../../../gems/i18n"
gem "tzinfo", path: "../../../../gems/tzinfo"
gem "concurrent-ruby", path: "../../../../gems/concurrent-ruby"
gem "rack", path: "../../../../gems/rack"
gem "builder", path: "../../../../gems/builder"
gem "connection_pool", "< 3"
gem "minitest-mock"
gem "dalli", ">= 3.0.1", "< 5"
gem "listen", "~> 3.3"
gem "msgpack", ">= 1.7.0"
gem "redis", ">= 4.0.1", "< 7"
gem "nokogiri", ">= 1.8.1", "!= 1.11.0"
gem "rake", ">= 13"

shipped "minitest", "base64", "bigdecimal", "drb", "json", "logger", "uri", "rexml", "date", "psych", "stringio", "erb", "prism"
