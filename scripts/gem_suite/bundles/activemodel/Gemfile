# The gems activemodel's tests load, at the versions the rails repository's
# own Gemfile allows: activesupport and what it loads, and bcrypt for
# has_secure_password, whose C extension Metorex builds when it is first
# loaded. railtie_test's five tests fail under either engine, since
# loading the railtie requires actionpack, which the bundle leaves out.
source "https://rubygems.org"

eval_gemfile "../ruby_shipped.rb"

gem "activemodel", path: "../../../../gems/rails/activemodel"
gem "activesupport", path: "../../../../gems/rails/activesupport"
gem "i18n", path: "../../../../gems/i18n"
gem "tzinfo", path: "../../../../gems/tzinfo"
gem "concurrent-ruby", path: "../../../../gems/concurrent-ruby"
gem "rack", path: "../../../../gems/rack"
gem "builder", path: "../../../../gems/builder"
gem "connection_pool", "< 3"
gem "minitest-mock"
gem "bcrypt", "~> 3.1.11"
gem "rake", ">= 13"

shipped "minitest", "base64", "bigdecimal", "drb", "json", "logger", "uri", "rexml", "date", "psych", "stringio", "erb", "prism"
