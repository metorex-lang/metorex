# The gems shoulda-matchers' specs load, as its Rails 8.1 appraisal names
# them: appraisal and warnings_logger for its helpers, rspec-rails,
# rails-controller-testing, shoulda-context, bcrypt and sqlite3, with pry,
# which its spec helper requires. The rails gem and every framework come from
# the checkouts, since the application its unit specs generate requires
# rails/all and runs with this Gemfile. Gems the appraisal adds for a
# generated application's own use, such as capybara, puma and the solid
# adapters, are left out.
#
# The gems Ruby 4.0.10 ships are named with the versions
# scripts/gem_suite/bundles/ruby_shipped.rb gives, since Appraisal reads this
# Gemfile with a DSL of its own, which has no eval_gemfile.
#
# The suite runs with this Gemfile copied into the copy of the checkout's
# gemfiles directory, since its helpers refuse to run with a Gemfile that is
# not an appraisal's.
source "https://rubygems.org"

repository = ENV["REPO_ROOT"] || "../../../.."

gem "activestorage", path: "#{repository}/gems/rails/activestorage"
gem "actioncable", path: "#{repository}/gems/rails/actioncable"
gem "actionmailbox", path: "#{repository}/gems/rails/actionmailbox"
gem "actionmailer", path: "#{repository}/gems/rails/actionmailer"
