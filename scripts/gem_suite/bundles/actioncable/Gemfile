# The gems actioncable's tests load, at the versions the rails repository's
# own Gemfile allows: actionpack and what it loads, puma, nio4r and
# websocket-driver for the server, redis for the redis adapter's tests,
# and websocket-client-simple for the client's. puma, nio4r and
# websocket-driver come from rubygems.org, so Metorex builds their
# extensions when they are first loaded. websocket-driver and
# websocket-extensions are held at the versions the rails repository's
# lockfile names, since websocket-driver 0.9.0 refuses a handshake without
# a Sec-WebSocket-Version header, and the tests' requests send none.
source "https://rubygems.org"

eval_gemfile "../ruby_shipped.rb"

gem "actioncable", path: "../../../../gems/rails/actioncable"
