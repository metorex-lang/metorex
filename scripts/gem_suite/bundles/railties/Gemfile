# The gems railties' tests load, at the versions the rails repository's
# lockfile names: the rails gem and every framework, since the application
# the isolated tests build requires rails/all, with what each loads,
# propshaft and importmap-rails, which that application requires, and
# minitest-retry for the isolation helper. sprockets-rails and sprockets
# come from rubygems.org, as the lockfile takes them, since Bundler
# evaluates a checkout's gemspec, and sprockets-rails' defines
# Sprockets::Rails, which importmap-rails reads as the railtie having
# loaded. The rest are what the generated applications and their tests
# load: capybara and selenium-webdriver for system tests, the solid
# adapters, dalli for the production cache store, bootsnap, bcrypt,
# jbuilder, web-console, listen, rack-cache, puma, webrick, and the gems a
# generated application's Gemfile names, kamal, thruster, debug,
# bundler-audit, brakeman and rubocop-rails-omakase. Those with
# C extensions come from rubygems.org, so Metorex builds them when they
# are first loaded. The tests that need PostgreSQL fail without pg.
#
# The suite runs with the frameworks from the copy of the rails repository
# GEM_SUITE_CHECKOUT names the railties directory of, since tests compare
# the paths the frameworks load from with the copy's.
source "https://rubygems.org"

repository = ENV["REPO_ROOT"] || "../../../.."
rails = ENV["GEM_SUITE_CHECKOUT"] ? File.dirname(ENV["GEM_SUITE_CHECKOUT"]) : "#{repository}/gems/rails"

eval_gemfile "#{repository}/scripts/gem_suite/bundles/ruby_shipped.rb"

gem "activestorage", path: "#{rails}/activestorage"
gem "actioncable", path: "#{rails}/actioncable"
gem "actionmailbox", path: "#{rails}/actionmailbox"
gem "actionmailer", path: "#{rails}/actionmailer"
