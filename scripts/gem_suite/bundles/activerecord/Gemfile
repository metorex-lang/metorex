# The gems activerecord's tests load against SQLite, at the versions the
# rails repository's own Gemfile allows: activemodel, activesupport and what
# they load, activejob and globalid for the tests that enqueue jobs,
# zeitwerk for the inheritance tests, and sqlite3, whose C extension Metorex
# builds when it is first loaded. database_selector_test and
# shard_selector_test load actionpack, which the bundle leaves out, so they
# stop before running under either engine.
source "https://rubygems.org"

eval_gemfile "../ruby_shipped.rb"

gem "activerecord", path: "../../../../gems/rails/activerecord"
gem "activemodel", path: "../../../../gems/rails/activemodel"
gem "activesupport", path: "../../../../gems/rails/activesupport"
gem "activejob", path: "../../../../gems/rails/activejob"
gem "i18n", path: "../../../../gems/i18n"
gem "tzinfo", path: "../../../../gems/tzinfo"
gem "concurrent-ruby", path: "../../../../gems/concurrent-ruby"
gem "rack", path: "../../../../gems/rack"
gem "builder", path: "../../../../gems/builder"
gem "connection_pool", "< 3"
gem "minitest-mock"
gem "globalid", ">= 0.3.6"
gem "zeitwerk", path: "../../../../gems/zeitwerk"
gem "sqlite3", ">= 2.1"
gem "bcrypt", "~> 3.1.11"
gem "msgpack", ">= 1.7.0"
gem "rake", ">= 13"

shipped "minitest", "base64", "bigdecimal", "drb", "json", "logger", "uri", "rexml", "date", "psych", "stringio", "erb", "prism", "timeout"
