# The gems puma's tests load, with puma itself from the checkout, or from the
# copy of it GEM_SUITE_CHECKOUT names, since its tests prune the bundle down
# to puma's own paths and run puma through rackup. Its extension is built by
# scripts/run_gem_suites.sh under the engine the tests run with.
source "https://rubygems.org"

gem "puma", path: ENV.fetch("GEM_SUITE_CHECKOUT", "../../../../gems/puma")

gem "json", "~> 2.18"
gem "nio4r", "~> 2.7"
gem "minitest", ">= 5.26"
gem "minitest-proveit"
gem "minitest-stub-const"
gem "minitest-mock"
gem "concurrent-ruby", "~> 1.3"
gem "rack", "~> 3.2"
gem "rackup", "~> 2.3"
gem "logger"
gem "localhost", require: false
