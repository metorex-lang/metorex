# The gems unf's tests load, which its helper sets up through Bundler. unf is
# left out, since the tests load it from the checkout. On a Ruby with
# String#unicode_normalize, unf normalizes with that and leaves unf_ext out.
source "https://rubygems.org"

eval_gemfile "../ruby_shipped.rb"

group :development do
  gem "test-unit", SHIPPED_VERSIONS.fetch("test-unit")
end

shipped "power_assert"
